{
  "Qlik": {
    "Host": "qlik-central.sirket.local",
    "QrsPort": 4242,
    "EnginePort": 4747,

    "ClientCertificatePath": "C:\\QlikCerts\\client.pfx",
    "ClientCertificatePassword": "",
    "RootCertificatePath": "C:\\QlikCerts\\root.cer",
    "AllowCertificateNameMismatch": false,

    "UserDirectory": "INTERNAL",
    "UserId": "sa_api",

    "RequestTimeoutSeconds": 120,
    "ExportTimeoutSeconds": 3600,
    "EngineRequestTimeoutSeconds": 600,
    "ReadRetryCount": 3,
    "ReadRetryBaseDelaySeconds": 2,

    "ScenarioAEngineIdentity": "AppOwner",
    "BackupOpenWithoutData": true,
    "UseIsolatedEngineSession": true
  },

  "Excel": {
    "SheetName": "Sheet1",
    "AppIdColumn": "AppId",
    "SheetIdColumn": "SheetId",
    "HeaderSearchRows": 20
  },

  "Processing": {
    "BackupFolder": "D:\\QlikSheetCleanup\\backups",
    "MaxDegreeOfParallelism": 1,
    "AllowCommunitySheetDelete": false,
    "ExportSkipData": false,
    "SheetIdMatch": "Auto"
  },

  "Logging": {
    "LogFolder": "logs",
    "MinimumLevel": "Information"
  }
}
